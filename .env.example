# Copy to .env and fill in. Never commit the real .env file.
# Full explanation of every setting: docs/ENVIRONMENT_SETUP.md

# --- Core ---
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Every builder domain, comma-separated (a leading dot allows sub-domains: .localhost for m3m.localhost etc.).
# Production example: m3mhome.in,www.m3mhome.in,acehome.in,www.acehome.in
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
# Production: https:// + every builder domain, e.g. https://m3mhome.in,https://www.m3mhome.in,https://acehome.in
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Builders & domains (multi-tenant) ---
# Host names that only serve the admin (no builder website), e.g. admin.yourcompany.in. Optional.
PLATFORM_ADMIN_HOSTS=admin.localhost
# Name shown in the admin header.
PLATFORM_NAME=Builder websites
# Scheme for canonical links (https in production; http is fine on a laptop).
SITE_SCHEME=https
# Seconds each web process remembers which builder a domain belongs to.
TENANT_CACHE_SECONDS=60

# --- HTTPS (production) ---
DJANGO_SECURE_SSL_REDIRECT=1
# Set to 31536000 only once every domain is permanently on HTTPS
DJANGO_HSTS_SECONDS=0

# --- Database: PostgreSQL (see docs/DATABASE_MIGRATION.md) ---
DB_ENGINE=postgres
DB_NAME=m3m_platform
DB_USER=m3m
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# "require" when the database is on another server, e.g. a managed cloud database
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60
# Rollback only, with the code from before the multi-builder change: DB_ENGINE=sqlite opens db.sqlite3
# (or DB_PATH). Do not run `migrate` against the original file. See docs/DATABASE_MIGRATION.md.
# DB_PATH=

# --- Enquiry notifications ---
# Each builder's own lead inbox is set in the admin (Contact & site settings → Enquiry forms).
# Addresses here get a copy of EVERY builder's leads (e.g. your own operations team). Leave empty if not wanted.
LEAD_NOTIFICATION_EMAILS=
LEAD_RATE_LIMIT_PER_HOUR=20

# --- Email (SMTP) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Builder websites <no-reply@example.com>
